# Supabase project. The client stores the session and sends its access token
# as Authorization: Bearer on Meals API requests.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Meals API. Leave empty in local dev to use the Vite /api proxy → localhost:3000.
VITE_API_BASE_URL=https://gitfit-backend-435679247323.europe-west1.run.app

# Optional. Sent as X-Api-Key when set. User identity is the Supabase JWT, not this key.
VITE_API_KEY=your-meals-api-key
