# Supabase (auth only)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Auth Edge Function URL (copy scripts/supabase-auth-edge-function into Supabase)
VITE_AUTH_FUNCTION_URL=https://xxxxxxxxxxxx.supabase.co/functions/v1/auth

# Meals API on Cloud Run (or leave empty in local dev to use Vite /api proxy)
VITE_API_BASE_URL=https://meals-api-xxxx-uc.a.run.app
VITE_API_KEY=your-meals-api-key
